<section class="section final">
  <div class="wrap">
    <h2 class="h2 rv">{{ section.settings.heading }} <em>{{ section.settings.accent }}</em></h2>
    {%- if section.settings.text != blank -%}<p class="rv">{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="btn solid rv" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Appel à l'action final",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Allumez votre" },
    { "type": "text", "id": "accent", "label": "Mot mis en lumière", "default": "intérieur" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Des luminaires design, des tailles et finitions pour chaque projet." },
    { "type": "text", "id": "button_label", "label": "Bouton — texte", "default": "Choisir mon luminaire" },
    { "type": "url", "id": "button_link", "label": "Bouton — lien" }
  ],
  "presets": [{ "name": "Appel à l'action final" }]
}
{% endschema %}
