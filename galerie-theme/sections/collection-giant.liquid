{%- assign coll = section.settings.collection | default: collections.all -%}
<section class="gr-wrap">
  {%- if section.settings.heading != blank -%}<h3>{{ section.settings.heading }}</h3>{%- endif -%}
  {%- for product in coll.products limit: section.settings.count -%}
    <a class="gr" href="{{ product.url }}" data-gr data-name="{{ product.title | escape }}" data-price="{% if product.price_varies %}dès {% endif %}{{ product.price | money_without_trailing_zeros }}"{% if product.featured_image %} data-img="{{ product.featured_image | image_url: width: 480 }}"{% endif %}>
      <span class="nm">{{ product.title }}</span>
      <span class="info"><b>{% if product.price_varies %}dès {% endif %}{{ product.price | money_without_trailing_zeros }}</b>{%- if product.type != blank -%}<i style="font-style:normal">{{ product.type }}</i>{%- endif -%}</span>
      {%- if product.featured_image -%}{{ product.featured_image | image_url: width: 168 | image_tag: loading: 'lazy', class: 'th', alt: '' }}{%- endif -%}
    </a>
  {%- else -%}
    <p class="sub" style="padding:0 24px">Ajoutez des produits à la collection pour les voir apparaître ici.</p>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Lignes géantes",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection (vide = tous les produits)" },
    { "type": "range", "id": "count", "label": "Nombre de produits", "min": 3, "max": 16, "step": 1, "default": 9 },
    { "type": "text", "id": "heading", "label": "Phrase d'introduction", "default": "Toute la collection, du plus doux au plus spectaculaire." }
  ],
  "presets": [{ "name": "Lignes géantes" }]
}
{% endschema %}
