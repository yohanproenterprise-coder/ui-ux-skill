<header
  class="hero"
  data-hero
  data-3d="{{ section.settings.enable_3d }}"
  data-kelvin="{{ section.settings.default_kelvin }}"
  style="--hero-bg:{{ section.settings.bg }};{% if section.settings.min_height < 100 %}--hero-h:{{ section.settings.min_height }}svh;{% endif %}"
>
  {%- if section.settings.enable_3d -%}
    <canvas data-hero-canvas aria-hidden="true"></canvas>
  {%- elsif section.settings.image != blank -%}
    <div class="hero-img">{{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '800, 1200, 1800', sizes: '100vw', alt: '' }}</div>
  {%- endif -%}

  <div class="wrap">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow rv">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1 class="h1">
      {%- if section.settings.line_1 != blank -%}<span class="line"><span>{{ section.settings.line_1 }}</span></span>{%- endif -%}
      <span class="line"><span style="transition-delay:.14s">{{ section.settings.line_2 }} <em>{{ section.settings.accent }}</em></span></span>
    </h1>
    {%- if section.settings.lead != blank -%}<p class="lead rv" style="--d:500ms">{{ section.settings.lead }}</p>{%- endif -%}
    <div class="cta-row rv" style="--d:650ms">
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn solid">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.button_2_label != blank -%}
        <a href="{{ section.settings.button_2_link | default: routes.all_products_collection_url }}" class="btn">{{ section.settings.button_2_label }}</a>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="micro rv" style="--d:800ms">
        {%- for block in section.blocks -%}<span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>{%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.enable_3d -%}<p class="hint3d">Touchez un luminaire pour l'éteindre</p>{%- endif -%}

  {%- if section.settings.show_temperature -%}
    <div class="temp rv" style="--d:900ms" role="group" aria-label="Température de lumière">
      <div class="temp-h"><span>Votre lumière</span><output data-k-out>{{ section.settings.default_kelvin }} K</output></div>
      <input type="range" min="2200" max="6500" step="50" value="{{ section.settings.default_kelvin }}" data-k-range aria-label="Température de couleur en kelvins">
      <div class="temp-n"><span>Bougie</span><span>Chaud</span><span>Naturel</span><span>Froid</span></div>
    </div>
  {%- endif -%}
</header>

{%- if section.settings.enable_3d -%}
  <script src="{{ 'hero-scene.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Hero 3D",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Texte" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Luminaires design · Suspensions · Appliques · Lampes" },
    { "type": "text", "id": "line_1", "label": "Titre — ligne 1", "default": "Sculptez" },
    { "type": "text", "id": "line_2", "label": "Titre — ligne 2", "default": "votre" },
    { "type": "text", "id": "accent", "label": "Mot mis en lumière", "default": "lumière" },
    { "type": "textarea", "id": "lead", "label": "Texte d'intro", "default": "Des pièces graphiques, minérales ou aériennes qui transforment un intérieur en galerie. Choisissez votre taille, votre finition et votre température de lumière." },
    { "type": "text", "id": "button_label", "label": "Bouton principal — texte", "default": "Voir la collection" },
    { "type": "url", "id": "button_link", "label": "Bouton principal — lien" },
    { "type": "text", "id": "button_2_label", "label": "Bouton secondaire — texte" },
    { "type": "url", "id": "button_2_link", "label": "Bouton secondaire — lien" },
    { "type": "header", "content": "3D & lumière" },
    { "type": "checkbox", "id": "enable_3d", "label": "Scène 3D (suspensions cliquables)", "info": "Désactivez pour un hero plus léger (image ou fond uni).", "default": true },
    { "type": "image_picker", "id": "image", "label": "Image de fond (si la 3D est désactivée)" },
    { "type": "checkbox", "id": "show_temperature", "label": "Curseur de température de lumière", "default": true },
    { "type": "range", "id": "default_kelvin", "label": "Température par défaut (K)", "min": 2200, "max": 6500, "step": 100, "default": 3000 },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg", "label": "Fond", "default": "#080605" },
    { "type": "range", "id": "min_height", "label": "Hauteur minimale (% de l'écran)", "min": 50, "max": 100, "step": 5, "default": 100 }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point de réassurance",
      "settings": [{ "type": "text", "id": "text", "label": "Texte", "default": "Paiement sécurisé" }]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Hero 3D",
      "blocks": [
        { "type": "point", "settings": { "text": "Paiement sécurisé" } },
        { "type": "point", "settings": { "text": "Plusieurs tailles & finitions" } },
        { "type": "point", "settings": { "text": "LED incluses (selon modèle)" } }
      ]
    }
  ]
}
{% endschema %}
