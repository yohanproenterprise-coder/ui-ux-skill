<section class="at3" data-atelier>
  <div class="wrap at3-grid">
    <div class="at3-copy rv">
      {%- if section.settings.kicker != blank -%}<p class="eyebrow">{{ section.settings.kicker }}</p>{%- endif -%}
      <h2>{{ section.settings.heading }} <em>{{ section.settings.accent }}</em></h2>
      {%- if section.settings.text != blank -%}<p class="lede">{{ section.settings.text }}</p>{%- endif -%}
      <div class="at3-models" role="tablist" aria-label="Choisir un luminaire">
        {%- for block in section.blocks -%}
          {%- assign pr = block.settings.product -%}
          {%- case block.settings.style -%}{%- when 'bar' -%}{%- assign dn = 'Effet arête' -%}{%- when 'globes' -%}{%- assign dn = 'Globes' -%}{%- when 'ring' -%}{%- assign dn = 'Couronne' -%}{%- else -%}{%- assign dn = 'Cylindre' -%}{%- endcase -%}
          {%- assign nm = block.settings.label | default: pr.title | default: dn -%}
          <button type="button" class="at3-mdl{% if forloop.first %} on{% endif %}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-model="{{ block.settings.style }}" data-name="{{ nm | escape }}" data-price="{% if pr %}{% if pr.price_varies %}dès {% endif %}{{ pr.price | money_without_trailing_zeros }}{% endif %}" data-url="{{ pr.url }}" {{ block.shopify_attributes }}>
            <b>{{ nm }}</b><span>{{ block.settings.sub | default: pr.type }}</span>
          </button>
        {%- endfor -%}
      </div>
      <div class="at3-ctrl">
        <button type="button" class="at3-sw" role="switch" aria-checked="true" aria-label="Allumer ou éteindre" data-at-sw><i></i><span>Allumée</span></button>
        <label class="at3-rng" for="at-k-{{ section.id }}"><span>Teinte</span><input id="at-k-{{ section.id }}" type="range" min="2200" max="4000" step="100" value="3000" data-at-k><output data-at-ko>3000 K</output></label>
      </div>
      <div class="at3-buy"><div><p data-at-name></p><p data-at-price></p></div><a class="btn solid" href="#" data-at-link>Voir la fiche</a></div>
    </div>
    <div class="at3-stage rv"><canvas aria-label="Luminaire en 3D, glisser pour le faire tourner" role="img"></canvas><p class="at3-hint" aria-hidden="true">Glissez pour tourner</p></div>
  </div>
</section>
<script src="{{ 'atelier.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Atelier 3D",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Sur-titre", "default": "Atelier 3D" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Allumez-les" },
    { "type": "text", "id": "accent", "label": "Mot mis en lumière", "default": "vous-même." },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Tournez le luminaire, changez sa teinte de 2200 K à 4000 K et regardez la matière réagir." }
  ],
  "blocks": [
    {
      "type": "model",
      "name": "Luminaire 3D",
      "settings": [
        { "type": "select", "id": "style", "label": "Forme 3D", "info": "Choisissez la forme qui ressemble le plus au produit.", "options": [
          { "value": "cylinder", "label": "Cylindre marbre et cuivre" },
          { "value": "bar", "label": "Barre à tubes (effet arête)" },
          { "value": "globes", "label": "Globes opalins" },
          { "value": "ring", "label": "Couronne d'ampoules" }
        ], "default": "cylinder" },
        { "type": "product", "id": "product", "label": "Produit lié (nom, prix et lien)" },
        { "type": "text", "id": "label", "label": "Nom affiché (si pas de produit)" },
        { "type": "text", "id": "sub", "label": "Sous-titre (sinon le type du produit)" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    { "name": "Atelier 3D", "blocks": [ { "type": "model", "settings": { "style": "cylinder" } }, { "type": "model", "settings": { "style": "bar" } }, { "type": "model", "settings": { "style": "globes" } }, { "type": "model", "settings": { "style": "ring" } } ] }
  ]
}
{% endschema %}
