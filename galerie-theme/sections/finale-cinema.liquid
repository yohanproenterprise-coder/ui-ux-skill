<section class="fin"><canvas data-embers aria-hidden="true"></canvas>
  <div>
    <h2>{{ section.settings.heading }}<em>{{ section.settings.accent }}</em></h2>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}<a class="lt-cta" data-mag href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Finale cinéma",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Allumez" },
    { "type": "text", "id": "accent", "label": "Mot mis en lumière", "default": "la pièce." },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Toute la collection, le panier et la livraison, en un clic." },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Voir la collection" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" }
  ],
  "presets": [{ "name": "Finale cinéma" }]
}
{% endschema %}
