{%- if section.blocks.size > 0 -%}
  <section class="section alt">
    <div class="wrap">
      <div class="center">
        <p class="kicker rv">{{ section.settings.kicker }}</p>
        <h2 class="h2 rv">{{ section.settings.heading }} <em>{{ section.settings.accent }}</em></h2>
      </div>
      <div class="rev">
        {%- for block in section.blocks -%}
          <blockquote class="rv" style="--d:{{ forloop.index0 | times: 120 }}ms" {{ block.shopify_attributes }}>
            <span class="stars" aria-label="{{ block.settings.rating }} étoiles sur 5">{%- for i in (1..block.settings.rating) -%}★{%- endfor -%}</span>
            <p>« {{ block.settings.quote }} »</p>
            <cite>{{ block.settings.author }}{% if block.settings.product != blank %} · {{ block.settings.product }}{% endif %}</cite>
          </blockquote>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Avis clients",
  "settings": [
    { "type": "paragraph", "content": "N'affichez ici que de vrais avis de clients. Pour des avis automatiques et vérifiés, installez une application d'avis (Judge.me, Loox…) : elle s'ajoute dans la fiche produit." },
    { "type": "text", "id": "kicker", "label": "Sur-titre", "default": "Ils ont choisi la lumière" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ce que disent nos" },
    { "type": "text", "id": "accent", "label": "Mot mis en lumière", "default": "clients" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avis",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Avis" },
        { "type": "text", "id": "author", "label": "Prénom, ville" },
        { "type": "text", "id": "product", "label": "Produit acheté" },
        { "type": "range", "id": "rating", "label": "Note", "min": 1, "max": 5, "step": 1, "default": 5 }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Avis clients" }]
}
{% endschema %}
