{%- if section.settings.video != blank -%}
<section class="flm">
  <div class="big" aria-hidden="true">{{ section.settings.big }}</div>
  <div class="in">
    <div class="txt"><p class="kicker">{{ section.settings.kicker }}</p><h2>{{ section.settings.heading }} <em>{{ section.settings.accent }}</em></h2></div>
    <div class="phone" data-phone><div>{{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, image_size: '600x', data-film: '' }}</div></div>
    <div class="txt r"><p>{{ section.settings.text }}</p></div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Film vertical",
  "settings": [
    { "type": "video", "id": "video", "label": "Vidéo verticale (9:16)", "info": "Hébergée par Shopify. La section reste masquée sans vidéo." },
    { "type": "text", "id": "big", "label": "Grand texte en fond", "default": "16 s" },
    { "type": "text", "id": "kicker", "label": "Sur-titre", "default": "Le film" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Du noir à" },
    { "type": "text", "id": "accent", "label": "Mot mis en lumière", "default": "la lumière." },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Un film vertical pour les réseaux." }
  ],
  "presets": [{ "name": "Film vertical" }]
}
{% endschema %}
