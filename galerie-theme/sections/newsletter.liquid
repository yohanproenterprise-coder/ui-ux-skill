<section class="section alt news">
  <div class="wrap">
    <p class="kicker rv">{{ section.settings.kicker }}</p>
    <h2 class="h2 rv">{{ section.settings.heading }} <em>{{ section.settings.accent }}</em></h2>
    {%- if section.settings.text != blank -%}<p class="sub rv">{{ section.settings.text }}</p>{%- endif -%}
    {%- form 'customer', id: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="sr-only" for="nl-email">Adresse email</label>
      <input id="nl-email" type="email" name="contact[email]" placeholder="Votre adresse email" autocomplete="email" required value="{{ form.email }}">
      <button type="submit" class="btn solid">{{ section.settings.button_label }}</button>
      {%- if form.posted_successfully? -%}<p class="ok" role="status" style="flex-basis:100%">Merci, vous êtes inscrit(e) !</p>{%- endif -%}
      {%- if form.errors -%}<p class="err" role="alert" style="flex-basis:100%">{{ form.errors | default_errors }}</p>{%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Sur-titre", "default": "Restez dans la lumière" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Nouveautés &" },
    { "type": "text", "id": "accent", "label": "Mot mis en lumière", "default": "inspirations" },
    { "type": "textarea", "id": "text", "label": "Texte", "info": "Si vous offrez un code de bienvenue, indiquez-le ici (et créez-le dans Shopify).", "default": "Recevez nos nouveautés et conseils d'éclairage." },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "S'inscrire" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
