<section class="section">
  <div class="wrap">
    <div class="sh">
      <div>
        {%- if section.settings.kicker != blank -%}<p class="kicker rv">{{ section.settings.kicker }}</p>{%- endif -%}
        <h2 class="h2 rv">{{ section.settings.heading }} <em>{{ section.settings.accent }}</em></h2>
      </div>
      <a href="{{ routes.collections_url }}" class="link rv">Toutes les collections</a>
    </div>
    <div class="tiles" style="--cols:{{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- assign t_url = block.settings.link | default: c.url | default: routes.all_products_collection_url -%}
        <a class="tile rv" href="{{ t_url }}" style="--d:{{ forloop.index0 | times: 90 }}ms" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 500, 700', sizes: '(min-width: 980px) 25vw, 50vw', alt: block.settings.title }}
          {%- elsif c.image -%}
            {{ c.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: c.title }}
          {%- elsif c.products.first.featured_image -%}
            {{ c.products.first.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: c.title }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag }}
          {%- endif -%}
          <span class="go" aria-hidden="true">{% render 'icon', name: 'arrow' %}</span>
          <div>
            <h3>{{ block.settings.title | default: c.title }}</h3>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections / pièces",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Sur-titre", "default": "Par pièce" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Une lumière pour" },
    { "type": "text", "id": "accent", "label": "Mot mis en lumière", "default": "chaque pièce" },
    { "type": "range", "id": "columns", "label": "Colonnes", "min": 2, "max": 4, "step": 1, "default": 4 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tuile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image (sinon celle de la collection)" },
        { "type": "text", "id": "title", "label": "Titre (sinon celui de la collection)" },
        { "type": "text", "id": "text", "label": "Description" },
        { "type": "url", "id": "link", "label": "Lien personnalisé (optionnel)" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Collections / pièces",
      "blocks": [
        { "type": "tile", "settings": { "title": "Salon", "text": "Suspensions & lustres" } },
        { "type": "tile", "settings": { "title": "Salle à manger", "text": "Au-dessus de la table" } },
        { "type": "tile", "settings": { "title": "Chambre", "text": "Appliques & lampes" } },
        { "type": "tile", "settings": { "title": "Bureau", "text": "Lumière précise" } }
      ]
    }
  ]
}
{% endschema %}
