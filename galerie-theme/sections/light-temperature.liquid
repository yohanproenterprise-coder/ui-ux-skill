<section class="section">
  <div class="wrap">
    <p class="kicker rv">{{ section.settings.kicker }}</p>
    <h2 class="h2 rv">{{ section.settings.heading }} <em>{{ section.settings.accent }}</em></h2>
    {%- if section.settings.text != blank -%}<p class="sub rv">{{ section.settings.text }}</p>{%- endif -%}
    <div class="temps">
      <button type="button" class="tcard rv" style="--c:#ffb55c" data-set-kelvin="3000">
        <div class="k">3000 K</div><h3>Chaud</h3><p>{{ section.settings.warm_text }}</p><span class="ap">Salon · Chambre →</span>
      </button>
      <button type="button" class="tcard rv" style="--c:#ffe3bd;--d:120ms" data-set-kelvin="4000">
        <div class="k">4000 K</div><h3>Naturel</h3><p>{{ section.settings.neutral_text }}</p><span class="ap">Cuisine · Entrée →</span>
      </button>
      <button type="button" class="tcard rv" style="--c:#cfe3ff;--d:240ms" data-set-kelvin="6000">
        <div class="k">6000 K</div><h3>Froid</h3><p>{{ section.settings.cool_text }}</p><span class="ap">Bureau · Travail →</span>
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Température de lumière",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Sur-titre", "default": "Température de couleur" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Quelle lumière" },
    { "type": "text", "id": "accent", "label": "Mot mis en lumière", "default": "choisir ?" },
    { "type": "textarea", "id": "text", "label": "Introduction", "default": "La même pièce n'a pas le même visage selon la température de couleur. Touchez une carte : toute la page s'éclaire différemment." },
    { "type": "textarea", "id": "warm_text", "label": "Texte — chaud", "default": "Cocon, douceur, soirées. La référence pour le salon, la chambre et la salle à manger." },
    { "type": "textarea", "id": "neutral_text", "label": "Texte — naturel", "default": "Lumière franche et équilibrée, fidèle aux couleurs. Cuisine, entrée, espaces de vie actifs." },
    { "type": "textarea", "id": "cool_text", "label": "Texte — froid", "default": "Lumière vive et tonique pour se concentrer. Bureau, plan de travail, zones techniques." }
  ],
  "presets": [{ "name": "Température de lumière" }]
}
{% endschema %}
