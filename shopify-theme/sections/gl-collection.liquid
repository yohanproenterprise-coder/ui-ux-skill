{% render 'gl-assets' %}

{%- assign coll = section.settings.collection | default: collections.all -%}

{%- comment -%} Types de produits uniques, pour les filtres {%- endcomment -%}
{%- assign types_str = '' -%}
{%- for product in coll.products limit: section.settings.products_count -%}
  {%- assign t = product.type | strip -%}
  {%- if t != blank -%}
    {%- capture marker -%}|{{ t }}|{%- endcapture -%}
    {%- unless types_str contains marker -%}{%- assign types_str = types_str | append: marker -%}{%- endunless -%}
  {%- endif -%}
{%- endfor -%}
{%- assign types = types_str | split: '|' -%}

<section class="gl gl-pad" id="gl-{{ section.id }}" data-gl-grid style="--gl-bg:{{ section.settings.bg }};--gl-text:{{ section.settings.text }};--gl-card:{{ section.settings.card }};">
  <div class="gl-wrap">
    <div class="gl-shead">
      <div>
        {%- if section.settings.kicker != blank -%}<p class="gl-kicker gl-rv">{{ section.settings.kicker }}</p>{%- endif -%}
        <h2 class="gl-h2 gl-rv">{{ section.settings.heading }} <em>{{ section.settings.accent }}</em></h2>
      </div>
      {%- if section.settings.show_filters and types.size > 1 -%}
        <div class="gl-filters gl-rv" role="tablist" aria-label="Filtrer par catégorie">
          <button class="gl-chip on" role="tab" aria-selected="true" data-type="">Tout</button>
          {%- for t in types -%}
            {%- if t != blank -%}<button class="gl-chip" role="tab" aria-selected="false" data-type="{{ t | escape }}">{{ t }}</button>{%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="gl-grid">
      {%- for product in coll.products limit: section.settings.products_count -%}
        <a href="{{ product.url }}" class="gl-card gl-rv" data-type="{{ product.type | escape }}" style="--gl-d:{{ forloop.index0 | modulo: 4 | times: 80 }}ms">
          <div class="gl-card-img">
            {%- if product.featured_image -%}
              {{- product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300, 500, 700', sizes: '(min-width: 1240px) 280px, (min-width: 600px) 33vw, 100vw', alt: product.featured_image.alt | default: product.title -}}
            {%- else -%}
              {{- 'product-1' | placeholder_svg_tag -}}
            {%- endif -%}
            <div class="gl-shine"></div>
            {%- unless product.available -%}<span class="gl-badge">Épuisé</span>{%- endunless -%}
          </div>
          <div class="gl-info">
            <div>
              <h3>{{ product.title }}</h3>
              {%- if product.type != blank -%}<small>{{ product.type }}</small>{%- endif -%}
            </div>
            {%- if section.settings.show_price -%}
              <div class="gl-price">
                {%- if product.price_varies -%}<span>dès</span>{%- endif -%}
                {{ product.price_min | money_without_trailing_zeros }}
                {%- if product.compare_at_price > product.price and product.price_varies == false -%}
                  <s>{{ product.compare_at_price | money_without_trailing_zeros }}</s>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="gl-more gl-rv">
        <a class="gl-btn" href="{{ coll.url | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "GL · Collection animée",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Sur-titre", "default": "La collection" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Pièces" },
    { "type": "text", "id": "accent", "label": "Mot mis en lumière", "default": "signature" },
    { "type": "collection", "id": "collection", "label": "Collection (vide = tous les produits)" },
    { "type": "range", "id": "products_count", "label": "Nombre de produits", "min": 4, "max": 24, "step": 2, "default": 12 },
    { "type": "checkbox", "id": "show_filters", "label": "Filtres par type de produit", "default": true },
    { "type": "checkbox", "id": "show_price", "label": "Afficher le prix", "default": true },
    { "type": "text", "id": "button_label", "label": "Bouton « voir tout »", "default": "Voir toute la collection" },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg", "label": "Fond", "default": "#080605" },
    { "type": "color", "id": "card", "label": "Fond des cartes", "default": "#1a1612" },
    { "type": "color", "id": "text", "label": "Texte", "default": "#f4efe6" }
  ],
  "presets": [{ "name": "GL · Collection animée" }]
}
{% endschema %}
