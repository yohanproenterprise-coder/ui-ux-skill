{% render 'gl-assets' %}

<section class="gl gl-pad" style="--gl-bg:{{ section.settings.bg }};--gl-text:{{ section.settings.text }};">
  <div class="gl-wrap">
    {%- if section.settings.kicker != blank -%}<p class="gl-kicker gl-rv">{{ section.settings.kicker }}</p>{%- endif -%}
    <h2 class="gl-h2 gl-rv">{{ section.settings.heading }} <em>{{ section.settings.accent }}</em></h2>

    <div class="gl-rooms">
      {%- for block in section.blocks -%}
        <a class="gl-room gl-rv" href="{{ block.settings.link | default: '#' }}" style="--gl-d:{{ forloop.index0 | times: 120 }}ms" {{ block.shopify_attributes }}>
          {%- if block.settings.image -%}
            {{- block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 700, 900', sizes: '(min-width: 860px) 33vw, 100vw', alt: block.settings.title -}}
          {%- else -%}
            {{- 'lifestyle-1' | placeholder_svg_tag -}}
          {%- endif -%}
          <div>
            <h3>{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GL · Univers (pièces)",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Sur-titre", "default": "Univers" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Une lumière pour" },
    { "type": "text", "id": "accent", "label": "Mot mis en lumière", "default": "chaque pièce" },
    { "type": "color", "id": "bg", "label": "Fond", "default": "#12100d" },
    { "type": "color", "id": "text", "label": "Texte", "default": "#f4efe6" }
  ],
  "blocks": [
    {
      "type": "room",
      "name": "Pièce",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Salon" },
        { "type": "text", "id": "text", "label": "Description", "default": "Suspensions minimalistes, ambiance wabi-sabi" },
        { "type": "url", "id": "link", "label": "Lien (collection)" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{
    "name": "GL · Univers (pièces)",
    "blocks": [
      { "type": "room", "settings": { "title": "Salon", "text": "Suspensions minimalistes, ambiance wabi-sabi" } },
      { "type": "room", "settings": { "title": "Salle à manger", "text": "Lustres sculpturaux pour les grandes tables" } },
      { "type": "room", "settings": { "title": "Chambre", "text": "Appliques et lampes à la lumière douce" } }
    ]
  }]
}
{% endschema %}
