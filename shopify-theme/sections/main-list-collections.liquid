<style>
/* ── Hero ── */
.lc-hero {
  padding: 64px 0 40px;
  text-align: center;
}
.lc-hero .eyebrow { margin-bottom: 12px; }
.lc-hero__title {
  font-size: clamp(1.8rem, 4.5vw, 3rem);
  font-weight: 800; letter-spacing: .08em;
  text-transform: uppercase; color: #2A1C10;
  margin: 0 0 12px;
}
.lc-hero__sub {
  font-size: .90rem; color: #8a7060; line-height: 1.7;
  max-width: 460px; margin: 0 auto;
}

/* ── Grid ── */
.lc-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px 24px;
  padding-bottom: 72px;
}
@media (max-width: 860px) { .lc-grid { grid-template-columns: repeat(2, 1fr); gap: 20px 16px; } }
@media (max-width: 480px) { .lc-grid { grid-template-columns: 1fr; gap: 16px; } }

/* ── Collection card ── */
.lc-card {
  position: relative;
  text-decoration: none;
  color: inherit;
  display: block;
  border-radius: 18px;
  overflow: hidden;
  background: #1a1410;
  aspect-ratio: 4/5;
  transform-style: preserve-3d;
  transition: transform .05s linear, box-shadow .4s ease;
  will-change: transform;
  box-shadow: 0 8px 32px rgba(42,28,16,.10);
}
.lc-card:hover {
  box-shadow: 0 20px 60px rgba(42,28,16,.22);
}

/* Image */
.lc-card__img {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  object-fit: cover; object-position: center;
  transition: transform .7s cubic-bezier(.25,.46,.45,.94), filter .5s ease;
  filter: brightness(0.72) saturate(0.9);
}
.lc-card:hover .lc-card__img {
  transform: scale(1.08);
  filter: brightness(0.62) saturate(1.05);
}

/* Gradient overlay */
.lc-card__gradient {
  position: absolute; inset: 0;
  background: linear-gradient(
    to top,
    rgba(10,7,4,0.92) 0%,
    rgba(10,7,4,0.45) 45%,
    rgba(10,7,4,0.12) 80%,
    transparent 100%
  );
  transition: opacity .4s ease;
}
.lc-card:hover .lc-card__gradient {
  background: linear-gradient(
    to top,
    rgba(10,7,4,0.96) 0%,
    rgba(10,7,4,0.55) 50%,
    rgba(10,7,4,0.18) 80%,
    transparent 100%
  );
}

/* Gold shimmer on hover */
.lc-card__shimmer {
  position: absolute; inset: 0;
  background: radial-gradient(
    circle at var(--sx,50%) var(--sy,90%),
    rgba(200,169,107,0.14) 0%,
    transparent 55%
  );
  opacity: 0; pointer-events: none;
  transition: opacity .35s ease;
}
.lc-card:hover .lc-card__shimmer { opacity: 1; }

/* Top badge */
.lc-card__count {
  position: absolute; top: 18px; right: 18px;
  background: rgba(200,169,107,0.18);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(200,169,107,0.25);
  color: #C8A96B;
  font-size: .60rem; font-weight: 700; letter-spacing: .14em;
  text-transform: uppercase; padding: 5px 12px; border-radius: 20px;
  z-index: 2;
}

/* Bottom info */
.lc-card__info {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: 28px 26px 26px;
  z-index: 2;
  transform: translateY(4px);
  transition: transform .4s cubic-bezier(.25,.46,.45,.94);
}
.lc-card:hover .lc-card__info { transform: translateY(0); }

.lc-card__eyebrow {
  font-size: .58rem; letter-spacing: .18em; text-transform: uppercase;
  color: #C8A96B; font-weight: 600; margin-bottom: 7px;
  opacity: 0; transform: translateY(6px);
  transition: opacity .35s ease .05s, transform .35s ease .05s;
}
.lc-card:hover .lc-card__eyebrow { opacity: 1; transform: translateY(0); }

.lc-card__title {
  font-size: clamp(1.1rem, 2vw, 1.4rem);
  font-weight: 800; letter-spacing: .06em;
  text-transform: uppercase; color: #F5F1EA;
  line-height: 1.15; margin: 0 0 12px;
}

.lc-card__cta {
  display: inline-flex; align-items: center; gap: 10px;
  font-size: .64rem; font-weight: 700; letter-spacing: .14em;
  text-transform: uppercase; color: #C8A96B;
  opacity: 0; transform: translateY(8px);
  transition: opacity .3s ease .1s, transform .3s ease .1s, gap .25s ease;
}
.lc-card:hover .lc-card__cta { opacity: 1; transform: translateY(0); }
.lc-card:hover .lc-card__cta:hover { gap: 16px; }
.lc-card__cta svg { width: 12px; height: 12px; flex-shrink: 0; }

/* Placeholder when no image */
.lc-card__placeholder {
  position: absolute; inset: 0;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 12px;
  background: linear-gradient(135deg, #1a1208, #0d0b07);
}
.lc-card__placeholder-icon { font-size: 2.8rem; opacity: .18; }

/* Reveal */
.lc-card.reveal {
  opacity: 0;
  transform: perspective(700px) translateY(24px) rotateX(5deg);
  transition: opacity .55s ease, transform .55s ease;
}
.lc-card.reveal.visible {
  opacity: 1;
  transform: perspective(700px) translateY(0) rotateX(0);
}
</style>

<div class="page-width">

  <div class="lc-hero">
    <div class="eyebrow">La Galerie Lumineuse</div>
    <h1 class="lc-hero__title">Nos Collections</h1>
    <p class="lc-hero__sub">Explorez notre sélection de luminaires par univers — de la suspension architecturale à la lampe d'ambiance.</p>
  </div>

  <div class="lc-grid">
    {% for collection in collections %}
      {% unless collection.handle == 'frontpage' or collection.handle == 'all' %}
        <a class="lc-card reveal" href="{{ collection.url }}" data-card>

          {% if collection.image %}
            <img class="lc-card__img"
                 src="{{ collection.image | image_url: width: 900 }}"
                 alt="{{ collection.image.alt | default: collection.title | escape }}"
                 loading="lazy" width="900">
          {% elsif collection.products.first and collection.products.first.featured_image %}
            <img class="lc-card__img"
                 src="{{ collection.products.first.featured_image | image_url: width: 900 }}"
                 alt="{{ collection.title | escape }}"
                 loading="lazy" width="900">
          {% else %}
            <div class="lc-card__placeholder">
              <span class="lc-card__placeholder-icon">✦</span>
            </div>
          {% endif %}

          <div class="lc-card__gradient"></div>
          <div class="lc-card__shimmer"></div>

          <span class="lc-card__count">
            {{ collection.products_count }} luminaire{% if collection.products_count != 1 %}s{% endif %}
          </span>

          <div class="lc-card__info">
            <div class="lc-card__eyebrow">Collection</div>
            <h2 class="lc-card__title">{{ collection.title }}</h2>
            <span class="lc-card__cta">
              Découvrir
              <svg viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 6.5h11M7 2l5 4.5L7 11"/>
              </svg>
            </span>
          </div>

        </a>
      {% endunless %}
    {% endfor %}
  </div>

</div>

<script>
(function(){
  var TILT = 7;

  /* Reveal */
  var cards = document.querySelectorAll('.lc-card.reveal');
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){ e.target.classList.add('visible'); io.unobserve(e.target); }
    });
  }, { threshold: 0.05, rootMargin: '0px 0px -30px 0px' });
  cards.forEach(function(c){ io.observe(c); });

  /* 3D tilt + shimmer */
  cards.forEach(function(card){
    card.addEventListener('mousemove', function(e){
      var r  = card.getBoundingClientRect();
      var rx = ((e.clientY - r.top  - r.height/2) / (r.height/2)) * -TILT;
      var ry = ((e.clientX - r.left - r.width/2)  / (r.width/2))  *  TILT;
      card.style.transform = 'perspective(900px) rotateX('+rx+'deg) rotateY('+ry+'deg) translateZ(12px)';
      card.style.transition = 'transform .05s linear';
      card.style.setProperty('--sx', ((e.clientX - r.left) / r.width * 100).toFixed(1) + '%');
      card.style.setProperty('--sy', ((e.clientY - r.top)  / r.height * 100).toFixed(1) + '%');
    });
    card.addEventListener('mouseleave', function(){
      card.style.transform = 'perspective(900px) rotateX(0) rotateY(0) translateZ(0)';
      card.style.transition = 'transform .55s cubic-bezier(.25,.46,.45,.94)';
    });
  });
})();
</script>

{% schema %}
{
  "name": "Liste des collections",
  "settings": [],
  "presets": [{ "name": "Liste des collections" }]
}
{% endschema %}
