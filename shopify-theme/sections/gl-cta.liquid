{% render 'gl-assets' %}

<section class="gl gl-final gl-pad" style="--gl-bg:{{ section.settings.bg }};--gl-text:{{ section.settings.text }};">
  <div class="gl-wrap">
    <h2 class="gl-h2 gl-rv">{{ section.settings.heading }} <em>{{ section.settings.accent }}</em></h2>
    {%- if section.settings.button_label != blank -%}
      <a class="gl-btn gl-rv" style="--gl-d:150ms" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "GL · Appel final",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Allumez votre" },
    { "type": "text", "id": "accent", "label": "Mot mis en lumière", "default": "intérieur" },
    { "type": "text", "id": "button_label", "label": "Bouton — texte", "default": "Entrer dans la galerie" },
    { "type": "url", "id": "button_link", "label": "Bouton — lien" },
    { "type": "color", "id": "bg", "label": "Fond", "default": "#080605" },
    { "type": "color", "id": "text", "label": "Texte", "default": "#f4efe6" }
  ],
  "presets": [{ "name": "GL · Appel final" }]
}
{% endschema %}
